# ---------- Server ----------
BIND_ADDR=0.0.0.0:8090
RUST_LOG=info,awaaz=debug

# ---------- Database ----------
# Matches docker-compose.yml (host port 5440 -> container 5432)
DATABASE_URL=postgres://awaaz:awaaz@localhost:5440/awaaz

# ---------- WhatsApp Cloud API (Meta) ----------
# TODO: any random string you invent. You paste the same value into the Meta webhook setup page
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
# TODO: Meta App Dashboard > App settings > Basic > App secret
WHATSAPP_APP_SECRET=your-meta-app-secret
# TODO: Meta App Dashboard > WhatsApp > API Setup > access token
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
# TODO: Meta App Dashboard > WhatsApp > API Setup > Phone number ID (not the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_API_VERSION=v21.0

# ---------- Speech-to-text (any OpenAI-compatible /audio/transcriptions endpoint) ----------
# Free default: Groq Whisper. TODO: key from https://console.groq.com/keys
STT_BASE_URL=https://api.groq.com/openai/v1
STT_API_KEY=your-groq-api-key
# whisper-large-v3 is the most accurate (best for Pashto and Sindhi); whisper-large-v3-turbo is faster.
STT_MODEL=whisper-large-v3
# Other options: OpenAI  -> https://api.openai.com/v1 with model whisper-1
#                Local   -> http://localhost:8000/v1 (any whisper server), STT_API_KEY=none

# ---------- Language understanding ----------
# NLP_PROVIDER = openai_compat (Groq, Gemini, OpenRouter, Ollama, OpenAI...) or anthropic
NLP_PROVIDER=openai_compat
# Free default: Groq with an open model (same key as above).
NLP_BASE_URL=https://api.groq.com/openai/v1
NLP_API_KEY=your-groq-api-key
NLP_MODEL=openai/gpt-oss-120b
# Gemini free tier: NLP_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                   NLP_API_KEY=<key from aistudio.google.com/apikey>  NLP_MODEL=gemini-2.5-flash
# Fully local:      NLP_BASE_URL=http://localhost:11434/v1  NLP_API_KEY=none  NLP_MODEL=<an Ollama model>
# Anthropic:        NLP_PROVIDER=anthropic  NLP_API_KEY=<anthropic key>  NLP_MODEL=claude-sonnet-5-5

# ---------- Access control ----------
# Comma-separated WhatsApp numbers (digits only, with country code, no +) allowed to
# register a NEW business by messaging the bot. Example: 923001234567,923331234567
# TODO: put the business owners' numbers here
OWNER_ALLOWLIST=923001234567

# ---------- Business defaults ----------
# Daily summary is sent to owners at this hour, Pakistan time (0-23)
DAILY_SUMMARY_HOUR=21
# Dry run: write replies to the terminal and outbox.txt instead of sending them on WhatsApp.
# Useful while the Meta account is blocked, or to test without sending real messages.
WHATSAPP_DRY_RUN=false
