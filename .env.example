# ---------- Server ----------
# TODO: keep as-is for local dev; use 0.0.0.0:8080 inside Docker
BIND_ADDR=0.0.0.0:8080
RUST_LOG=info,awaaz=debug

# ---------- Database ----------
# Matches docker-compose.yml (host port 5433 -> container 5432)
DATABASE_URL=postgres://awaaz:awaaz@localhost:5433/awaaz

# ---------- WhatsApp Cloud API (Meta) ----------
# TODO: any random string you invent. You paste the same value into the Meta webhook setup page
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
# TODO: Meta App Dashboard > App settings > Basic > App secret
WHATSAPP_APP_SECRET=your-meta-app-secret
# TODO: Meta App Dashboard > WhatsApp > API Setup > temporary or permanent access token
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
# TODO: Meta App Dashboard > WhatsApp > API Setup > Phone number ID (not the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_API_VERSION=v21.0

# ---------- Speech-to-text (OpenAI Whisper) ----------
# TODO: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key
WHISPER_MODEL=whisper-1

# ---------- NLP (Claude) ----------
# TODO: https://console.anthropic.com/ > API keys
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-sonnet-5-5

# ---------- Access control ----------
# Comma-separated WhatsApp numbers (digits only, with country code, no +) allowed to
# register a NEW business by messaging the bot. Example: 923001234567,923331234567
# TODO: put the business owners' numbers here
OWNER_ALLOWLIST=923001234567

# ---------- Business defaults ----------
# Daily summary is sent to owners at this hour, Pakistan time (0-23)
DAILY_SUMMARY_HOUR=21